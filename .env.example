# =====================================================================
# PacePro AI - Primary AI Provider
# =====================================================================
# Supported providers: openai, anthropic, gemini
AI_PROVIDER=openai

# API Key for chosen AI provider
AI_API_KEY=

# Model name for primary provider
# Examples:
#   OpenAI:    gpt-4o, gpt-4o-mini, o3-mini
#   Anthropic: claude-sonnet-5, claude-3-5-sonnet-20241022, claude-3-haiku-20240307
#   Gemini:    gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
#   Qwen:      qwen3.7-flash, qwen-turbo, qwen-max
#   Ollama:    llama3.1, mistral, qwen2.5
API_MODEL_NAME=gpt-4o-mini

# Base URL (Optional - leave empty for official cloud APIs)
# Examples:
#   OpenAI (default):   leave blank or https://api.openai.com/v1
#   DashScope (Qwen):   https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama:             http://localhost:11434/v1
#   LM Studio:          http://localhost:1234/v1
#   Groq:               https://api.groq.com/openai/v1
#   DeepSeek:           https://api.deepseek.com/v1
#   OpenRouter:         https://openrouter.ai/api/v1
AI_API_BASE_URL=


# =====================================================================
# PacePro AI - Fallback AI Provider (Chain Step 1)
# Triggered automatically if Primary AI encounters rate limits, errors, or timeouts
# =====================================================================
FALLBACK_AI_PROVIDER=gemini

# API Key for fallback provider
FALLBACK_AI_API_KEY=

# Model name for fallback provider
# Examples: gemini-2.0-flash, gpt-4o-mini, claude-3-5-sonnet-20241022
FALLBACK_API_MODEL_NAME=gemini-2.0-flash

# Base URL for fallback provider (Optional)
FALLBACK_AI_API_BASE_URL=


# =====================================================================
# PacePro AI - Secondary Fallback AI Provider (Chain Step 2 - Optional)
# Triggered if both Primary and Fallback 1 fail
# =====================================================================
FALLBACK_2_AI_PROVIDER=anthropic

# API Key for secondary fallback provider
FALLBACK_2_AI_API_KEY=

# Model name for secondary fallback provider
FALLBACK_2_API_MODEL_NAME=claude-sonnet-5

# Base URL for secondary fallback provider (Optional)
FALLBACK_2_AI_API_BASE_URL=
